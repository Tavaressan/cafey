# Variáveis de ambiente do perfil "prod" (AWS IoT Core — INFRA-05).
# Copie para .env (git-ignorado) e preencha com os valores reais; NUNCA commitar .env
# nem os arquivos de certificado/chave apontados abaixo.
#
# Ver docs/docs_arquitetura/aws-iot-core-provisioning.md para como obter o endpoint e os
# certificados. certificate-path/private-key-path/root-ca-path apontam para arquivos locais
# montados a partir do AWS Secrets Manager (ou um volume seguro), nunca para conteúdo inline.

SPRING_PROFILES_ACTIVE=prod
AWS_IOT_ENDPOINT=SEU-ENDPOINT-ats.iot.SUA-REGIAO.amazonaws.com
AWS_IOT_CERTIFICATE_PATH=/run/secrets/cafey-backend-cert.pem
AWS_IOT_PRIVATE_KEY_PATH=/run/secrets/cafey-backend-private.key
AWS_IOT_ROOT_CA_PATH=/run/secrets/amazon-root-ca-1.pem

# E-mail de recuperação de senha via SMTP do AWS SES (issue #194). Host: email-smtp.<região>.amazonaws.com.
# Usuário/senha são as credenciais SMTP geradas no console do SES (não as chaves de acesso IAM).
# Enquanto a conta estiver no sandbox do SES, remetente e destinatários precisam ser identidades
# verificadas. CAFEY_MAIL_RESET_PASSWORD_URL aponta para a página estática servida pelo backend.
CAFEY_MAIL_FROM="Cafey <nao-responda@SEU-DOMINIO-VERIFICADO>"
CAFEY_MAIL_RESET_PASSWORD_URL=https://SEU-DOMINIO/redefinir-senha.html
CAFEY_MAIL_SMTP_HOST=email-smtp.SUA-REGIAO.amazonaws.com
CAFEY_MAIL_SMTP_PORT=587
CAFEY_MAIL_SMTP_USERNAME=SEU-USUARIO-SMTP-DO-SES
CAFEY_MAIL_SMTP_PASSWORD=SUA-SENHA-SMTP-DO-SES
