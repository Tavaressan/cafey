# Variáveis de ambiente do perfil "prod" (AWS IoT Core — INFRA-05).
# Copie para .env (git-ignorado) e preencha com os valores reais; NUNCA commitar .env
# nem os arquivos de certificado/chave apontados abaixo.
#
# Ver docs/docs_arquitetura/aws-iot-core-provisioning.md para como obter o endpoint e os
# certificados. certificate-path/private-key-path/root-ca-path apontam para arquivos locais
# montados a partir do AWS Secrets Manager (ou um volume seguro), nunca para conteúdo inline.

SPRING_PROFILES_ACTIVE=prod
AWS_IOT_ENDPOINT=SEU-ENDPOINT-ats.iot.SUA-REGIAO.amazonaws.com
AWS_IOT_CERTIFICATE_PATH=/run/secrets/cafey-backend-cert.pem
AWS_IOT_PRIVATE_KEY_PATH=/run/secrets/cafey-backend-private.key
AWS_IOT_ROOT_CA_PATH=/run/secrets/amazon-root-ca-1.pem
