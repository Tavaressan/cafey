{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:*:*:client/cafey-backend"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Publish",
        "iot:RetainPublish"
      ],
      "Resource": [
        "arn:aws:iot:*:*:topic/dispositivos/*/comando",
        "arn:aws:iot:*:*:topic/dispositivos/*/agendamentos"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Subscribe",
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:*:*:topicfilter/dispositivos/+/estado",
        "arn:aws:iot:*:*:topicfilter/dispositivos/+/eventos",
        "arn:aws:iot:*:*:topicfilter/dispositivos/+/saude",
        "arn:aws:iot:*:*:topic/dispositivos/*/estado",
        "arn:aws:iot:*:*:topic/dispositivos/*/eventos",
        "arn:aws:iot:*:*:topic/dispositivos/*/saude"
      ]
    }
  ]
}
