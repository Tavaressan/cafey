# KiCad — arquivos de preferência e cache locais da máquina
*-backups/
*.kicad_prl
fp-info-cache
~*.lck
*.bak
_autosave-*
*.net

# Histórico local automático do KiCad (snapshots + git interno próprio)
.history/

# Ferramentas do editor / assistente
.claude/
.vscode/

# Sistema
.DS_Store

# Firmware (ESP-IDF)
firmware/build/
firmware/test/build/
firmware/sdkconfig
firmware/sdkconfig.old

# Credenciais AWS IoT Core (INFRA-05) — nunca versionar chaves/certs reais
firmware/certs/*
!firmware/certs/*.example
backend/cafey-backend/src/main/resources/certs/
backend/cafey-backend/.env
!backend/cafey-backend/.env.example
backend/.env
!backend/.env.example

# Mecânica (FreeCAD) — saídas geradas e backups
mechanical/build/
*.FCStd1
*.FCBak

# Marca — PNG/PDF derivados dos SVGs por export-assets.ps1
docs/docs_interface/logo/assets/

# Python
__pycache__/
*.pyc
.vercel
.env*
