{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:*:*:client/${iot:Connection.Thing.ThingName}"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Publish"
      ],
      "Resource": [
        "arn:aws:iot:*:*:topic/dispositivos/${iot:Connection.Thing.ThingName}/eventos",
        "arn:aws:iot:*:*:topic/dispositivos/${iot:Connection.Thing.ThingName}/saude"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Publish",
        "iot:RetainPublish"
      ],
      "Resource": "arn:aws:iot:*:*:topic/dispositivos/${iot:Connection.Thing.ThingName}/estado"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iot:Subscribe",
        "iot:Receive"
      ],
      "Resource": [
        "arn:aws:iot:*:*:topicfilter/dispositivos/${iot:Connection.Thing.ThingName}/comando",
        "arn:aws:iot:*:*:topicfilter/dispositivos/${iot:Connection.Thing.ThingName}/agendamentos",
        "arn:aws:iot:*:*:topic/dispositivos/${iot:Connection.Thing.ThingName}/comando",
        "arn:aws:iot:*:*:topic/dispositivos/${iot:Connection.Thing.ThingName}/agendamentos"
      ]
    }
  ]
}
